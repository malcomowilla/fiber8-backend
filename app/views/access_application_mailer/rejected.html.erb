<!DOCTYPE html>
<html>
  <body style="margin:0;padding:24px;font-family:Arial,Helvetica,sans-serif;color:#111;background:#fff;">
    <div style="max-width:480px;margin:0 auto;">
      <h2 style="margin:0 0 16px;font-size:20px;">About your application</h2>
      <p style="margin:0 0 16px;font-size:14px;line-height:1.6;">Hi <%= @application.name %>,</p>
      <p style="margin:0 0 16px;font-size:14px;line-height:1.6;">
        We couldn't approve your application for <strong><%= @application.company_name %></strong> at this time.
      </p>
      <% if @application.rejection_reason.present? %>
        <p style="margin:0 0 16px;font-size:14px;line-height:1.6;">
          <strong>Reason:</strong> <%= @application.rejection_reason %>
        </p>
      <% end %>
      <p style="margin:0;font-size:13px;line-height:1.6;color:#555;">
        Reply to this email if you'd like to discuss it.
      </p>
    </div>
  </body>
</html>