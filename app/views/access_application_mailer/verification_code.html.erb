<!DOCTYPE html>
<html>
  <body style="margin:0;padding:24px;font-family:Arial,Helvetica,sans-serif;color:#111;background:#fff;">
    <div style="max-width:480px;margin:0 auto;">
      <h2 style="margin:0 0 16px;font-size:20px;">Verify your email</h2>
      <p style="margin:0 0 20px;font-size:14px;line-height:1.6;">
        Use this code to continue your Owitech application:
      </p>
      <p style="margin:0 0 20px;font-size:32px;font-weight:bold;letter-spacing:8px;font-family:monospace;">
        <%= @code %>
      </p>
      <p style="margin:0;font-size:13px;line-height:1.6;color:#555;">
        This code expires in 10 minutes. If you didn't request it, you can ignore this email.
      </p>
    </div>
  </body>
</html>