<div style="font-family: Arial, sans-serif; max-width: 520px; margin: 0 auto; color: #1a1a1a;">
  <h2 style="color: #059669;">Welcome to Owitech ISP!</h2>

  <p>Hi <%= @admin.username %>,</p>

  <p>Your admin account has been created. Here are your login credentials:</p>

  <table style="width: 100%; border-collapse: collapse; margin: 16px 0;">
    <tr>
      <td style="padding: 8px 0; font-weight: bold; width: 140px;">Username</td>
      <td style="padding: 8px 0;"><%= @admin.username %></td>
    </tr>
    <tr>
      <td style="padding: 8px 0; font-weight: bold;">Email</td>
      <td style="padding: 8px 0;"><%= @admin.email %></td>
    </tr>
    <tr>
      <td style="padding: 8px 0; font-weight: bold;">Password</td>
      <td style="padding: 8px 0;"><%= @password %></td>
    </tr>
  </table>

  <p>
    <a href="<%= @login_url %>" style="display: inline-block; background: #059669; color: #fff; padding: 10px 20px; border-radius: 8px; text-decoration: none;">
      Log in to your dashboard
    </a>
  </p>

  <p style="font-size: 13px; color: #6b7280;">
    Or visit: <%= @login_url %>
  </p>

  <p style="font-size: 13px; color: #6b7280;">
    For security, please change your password after logging in.
  </p>
</div>